<Window x:Class="DAPLibManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DAP Library Manager"
        Height="600" Width="900"
        MinHeight="400" MinWidth="600">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SelectFolderButton"
                    Grid.Column="0"
                    Content="Select Folder"
                    Width="110" Height="30"
                    Click="SelectFolderButton_Click" />

            <TextBlock x:Name="FolderPathText"
                       Grid.Column="1"
                       Text="No folder selected"
                       VerticalAlignment="Center"
                       Margin="10,0"
                       Foreground="Gray"
                       TextTrimming="CharacterEllipsis" />

            <Button x:Name="ScanButton"
                    Grid.Column="2"
                    Content="Scan Library"
                    Width="110" Height="30"
                    IsEnabled="False"
                    Click="ScanButton_Click" />
        </Grid>

        <!-- Track List -->
        <ListView x:Name="TrackListView"
                  Grid.Row="2"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Title" Width="280"
                                    DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="Artist" Width="180"
                                    DisplayMemberBinding="{Binding ArtistName}" />
                    <GridViewColumn Header="Album" Width="180"
                                    DisplayMemberBinding="{Binding AlbumTitle}" />
                    <GridViewColumn Header="Duration" Width="80"
                                    DisplayMemberBinding="{Binding Duration, StringFormat=hh\\:mm\\:ss}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Status bar -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,6,0,0"
                   Foreground="Gray"
                   FontSize="12" />
    </Grid>
</Window>
