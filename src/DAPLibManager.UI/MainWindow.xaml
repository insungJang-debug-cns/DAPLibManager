<Window x:Class="DAPLibManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DAPLibManager.UI.Converters"
        Title="재생목록 관리자"
        Icon="app.ico"
        Height="800" Width="1500"
        MinHeight="500" MinWidth="900">

    <Window.Resources>
        <converters:RelativePathConverter x:Key="RelativePath" />
        <converters:AlbumArtConverter x:Key="AlbumArt" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MediaElement x:Name="MediaPlayer"
                      Visibility="Collapsed"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      MediaOpened="MediaPlayer_MediaOpened"
                      MediaEnded="MediaPlayer_MediaEnded" />

        <!-- 3-panel content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="200" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="180" MinWidth="120" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Left: Toolbar / Search / [TreeView | TrackListView] -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SelectFolderButton"
                            Grid.Column="0"
                            Width="42" Height="36"
                            ToolTip="Select Folder"
                            Click="SelectFolderButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;" FontSize="18" />
                    </Button>

                    <TextBlock x:Name="FolderPathText"
                               Grid.Column="1"
                               Text="No folder selected"
                               VerticalAlignment="Center"
                               Margin="10,0"
                               FontSize="13"
                               Foreground="Gray"
                               TextTrimming="CharacterEllipsis" />

                    <Button x:Name="ScanButton"
                            Grid.Column="2"
                            Width="42" Height="36"
                            IsEnabled="False"
                            ToolTip="Scan Library"
                            Click="ScanButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="18" />
                    </Button>
                </Grid>

                <!-- Search bar (full width) -->
                <TextBox x:Name="SearchBox"
                         Grid.Row="2"
                         Height="36"
                         FontSize="13"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" />

                <!-- TreeView (left) + TrackListView (right) -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" MinWidth="80" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="2*" MinWidth="100" />
                    </Grid.ColumnDefinitions>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- Directory TreeView -->
                <TreeView x:Name="DirTreeView"
                          Grid.Column="0"
                          FontSize="13"
                          SelectedItemChanged="DirTreeView_SelectedItemChanged">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Padding" Value="2,3" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- horizontal dotted line -->
                                                <Rectangle Grid.Column="0" Height="1"
                                                           VerticalAlignment="Center"
                                                           Stroke="#BBBBBB" StrokeThickness="1"
                                                           StrokeDashArray="2,2" Fill="Transparent" />
                                                <DockPanel Grid.Column="1">
                                                    <ToggleButton x:Name="Expander" DockPanel.Dock="Left"
                                                                  Focusable="False" Width="16" Height="16"
                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="Transparent">
                                                                                <Path x:Name="Arrow" Fill="#666666"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Data="M 3 1 L 3 9 L 7 5 Z" />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="Arrow" Property="Data" Value="M 1 3 L 9 3 L 5 7 Z" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}">
                                                        <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </DockPanel>
                                            </Grid>
                                            <!-- vertical dotted line + children -->
                                            <Grid x:Name="ItemsGrid">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Width="1"
                                                           HorizontalAlignment="Center"
                                                           Stroke="#BBBBBB" StrokeThickness="1"
                                                           StrokeDashArray="2,2" Fill="Transparent" />
                                                <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" />
                                            </Grid>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="False">
                                                <Setter TargetName="ItemsGrid" Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.Resources>
                </TreeView>

                <!-- Library TrackListView -->
                <ListView x:Name="TrackListView"
                          Grid.Column="2"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="TrackListView_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="TrackListView_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="TrackListView_PreviewMouseMove">
                    <ListView.ContextMenu>
                        <ContextMenu Opened="TrackContextMenu_Opened" />
                    </ListView.ContextMenu>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="50" />
                            <Setter Property="FontSize" Value="13" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="32">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="StarButton_Click"
                                                Width="26" Height="26"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE734;" />
                                                        <Setter Property="Foreground" Value="#AAAAAA" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Text" Value="&#xE735;" />
                                                                <Setter Property="Foreground" Value="#FFD700" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="#FFAA00" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="54">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Width="42" Height="42"
                                               Source="{Binding FilePath, Converter={StaticResource AlbumArt}}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Title" Width="200"
                                            DisplayMemberBinding="{Binding Title}">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader"><Setter Property="IsHitTestVisible" Value="False"/></Style>
                                </GridViewColumn.HeaderContainerStyle>
                            </GridViewColumn>
                            <GridViewColumn Header="Artist" Width="150"
                                            DisplayMemberBinding="{Binding ArtistName}">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader"><Setter Property="IsHitTestVisible" Value="False"/></Style>
                                </GridViewColumn.HeaderContainerStyle>
                            </GridViewColumn>
                            <GridViewColumn Header="Album" Width="150"
                                            DisplayMemberBinding="{Binding AlbumTitle}">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader"><Setter Property="IsHitTestVisible" Value="False"/></Style>
                                </GridViewColumn.HeaderContainerStyle>
                            </GridViewColumn>
                            <GridViewColumn Header="Time" Width="65"
                                            DisplayMemberBinding="{Binding Duration, StringFormat=mm\\:ss}">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader"><Setter Property="IsHitTestVisible" Value="False"/></Style>
                                </GridViewColumn.HeaderContainerStyle>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                </Grid><!-- end TreeView+TrackList grid -->
            </Grid>

            <!-- Playlist panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="6,0,6,6">
                    <TextBlock Text="Playlists" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
                    <Button x:Name="NewPlaylistButton"
                            Width="28" Height="28"
                            HorizontalAlignment="Right"
                            IsEnabled="False"
                            ToolTip="New Playlist"
                            Click="NewPlaylistButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="15" />
                    </Button>
                </Grid>

                <ListView x:Name="PlaylistListView"
                          Grid.Row="1"
                          AllowDrop="True"
                          DragOver="PlaylistListView_DragOver"
                          Drop="PlaylistListView_Drop"
                          SelectionChanged="PlaylistListView_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6,5" />
                            <Setter Property="FontSize" Value="13" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button x:Name="DeletePlaylistButton"
                        Grid.Row="2"
                        Height="34" Margin="0,6,0,0"
                        IsEnabled="False"
                        ToolTip="Delete Playlist"
                        Click="DeletePlaylistButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="18" />
                </Button>
            </Grid>

            <!-- Playlist track list -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="6,0,0,6">
                    <TextBlock x:Name="PlaylistNameText"
                               FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="" />
                    <TextBlock x:Name="PlaylistTrackCountText"
                               HorizontalAlignment="Right"
                               FontSize="12" Foreground="Gray" />
                </Grid>

                <ListView x:Name="PlaylistTrackListView"
                          Grid.Row="1"
                          VirtualizingPanel.IsVirtualizing="True"
                          AllowDrop="True"
                          MouseDoubleClick="PlaylistTrackListView_MouseDoubleClick"
                          DragEnter="PlaylistTrackListView_DragEnter"
                          DragLeave="PlaylistTrackListView_DragLeave"
                          DragOver="PlaylistTrackListView_DragOver"
                          Drop="PlaylistTrackListView_Drop"
                          PreviewMouseLeftButtonDown="PlaylistTrackListView_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="PlaylistTrackListView_PreviewMouseMove">
                    <ListView.ContextMenu>
                        <ContextMenu Opened="PlaylistTrackContextMenu_Opened" />
                    </ListView.ContextMenu>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="FontSize" Value="13" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Title" Width="240"
                                            DisplayMemberBinding="{Binding Title}">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                            </GridViewColumn>
                            <GridViewColumn Header="Time" Width="65"
                                            DisplayMemberBinding="{Binding Duration, StringFormat=mm\\:ss}">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="ScanProgressBar"
                         Grid.Row="0"
                         Height="3"
                         Margin="0,0,0,4"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Foreground="Gray"
                       FontSize="13" />
        </Grid>

        <!-- Playback bar -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12,8"
                Background="#F5F5F5" CornerRadius="6"
                x:Name="PlaybackBar">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image x:Name="PlaybackArtImage" Grid.Column="0"
                       Width="90" Height="90" Margin="0,0,14,0"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="default_art.png" />

                <Button x:Name="PlayPauseButton" Grid.Column="1"
                        Width="38" Height="34" Margin="0,0,6,0"
                        IsEnabled="False"
                        ToolTip="Play / Pause" Click="PlayPauseButton_Click">
                    <TextBlock x:Name="PlayPauseIcon"
                               FontFamily="Segoe MDL2 Assets" Text="&#xE769;" FontSize="16" />
                </Button>
                <Button x:Name="StopButton" Grid.Column="2"
                        Width="38" Height="34" Margin="0,0,14,0"
                        IsEnabled="False"
                        ToolTip="Stop" Click="StopButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" FontSize="16" />
                </Button>

                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="NowPlayingText" Grid.Row="0"
                               FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <Slider x:Name="SeekBar" Grid.Row="1"
                            IsEnabled="False"
                            Margin="0,4,0,0" VerticalAlignment="Center"
                            PreviewMouseDown="SeekBar_PreviewMouseDown"
                            PreviewMouseUp="SeekBar_PreviewMouseUp" />
                </Grid>

                <StackPanel Grid.Column="4" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="TimeText"
                               VerticalAlignment="Center"
                               FontSize="12" Foreground="Gray" />
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE767;"
                               FontSize="15" Margin="14,0,6,0" VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider"
                            Width="100" VerticalAlignment="Center"
                            Minimum="0" Maximum="1" Value="1"
                            ValueChanged="VolumeSlider_ValueChanged" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
