<Window x:Class="DAPLibManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DAPLibManager.UI.Converters"
        Title="재생목록 관리자"
        Icon="app.ico"
        Height="600" Width="1200"
        MinHeight="400" MinWidth="800">

    <Window.Resources>
        <converters:RelativePathConverter x:Key="RelativePath" />
        <converters:AlbumArtConverter x:Key="AlbumArt" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MediaElement x:Name="MediaPlayer"
                      Visibility="Collapsed"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      MediaOpened="MediaPlayer_MediaOpened"
                      MediaEnded="MediaPlayer_MediaEnded" />

        <!-- 3-panel content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="200" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="160" MinWidth="100" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="2*" MinWidth="150" />
            </Grid.ColumnDefinitions>

            <!-- Left: Toolbar + Search + TrackListView -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SelectFolderButton"
                            Grid.Column="0"
                            Width="36" Height="30"
                            ToolTip="Select Folder"
                            Click="SelectFolderButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;" FontSize="16" />
                    </Button>

                    <TextBlock x:Name="FolderPathText"
                               Grid.Column="1"
                               Text="No folder selected"
                               VerticalAlignment="Center"
                               Margin="10,0"
                               Foreground="Gray"
                               TextTrimming="CharacterEllipsis" />

                    <Button x:Name="ScanButton"
                            Grid.Column="2"
                            Width="36" Height="30"
                            IsEnabled="False"
                            ToolTip="Scan Library"
                            Click="ScanButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="16" />
                    </Button>
                </Grid>

                <!-- Search bar -->
                <TextBox x:Name="SearchBox"
                         Grid.Row="2"
                         Height="30"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged" />

                <!-- Library TrackListView -->
                <ListView x:Name="TrackListView"
                          Grid.Row="4"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="TrackListView_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="TrackListView_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="TrackListView_PreviewMouseMove">
                    <ListView.ContextMenu>
                        <ContextMenu Opened="TrackContextMenu_Opened" />
                    </ListView.ContextMenu>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="42" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="46">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Width="36" Height="36"
                                               Source="{Binding FilePath, Converter={StaticResource AlbumArt}}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Title" Width="180"
                                            DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="Artist" Width="130"
                                            DisplayMemberBinding="{Binding ArtistName}" />
                            <GridViewColumn Header="Album" Width="130"
                                            DisplayMemberBinding="{Binding AlbumTitle}" />
                            <GridViewColumn Header="Time" Width="60"
                                            DisplayMemberBinding="{Binding Duration, StringFormat=mm\\:ss}" />
                            <GridViewColumn Header="Path" Width="200"
                                            DisplayMemberBinding="{Binding FilePath, Converter={StaticResource RelativePath}}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <!-- Playlist panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="Playlists" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button x:Name="NewPlaylistButton"
                            Width="24" Height="24"
                            HorizontalAlignment="Right"
                            IsEnabled="False"
                            ToolTip="New Playlist"
                            Click="NewPlaylistButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="13" />
                    </Button>
                </Grid>

                <ListView x:Name="PlaylistListView"
                          Grid.Row="1"
                          AllowDrop="True"
                          DragOver="PlaylistListView_DragOver"
                          Drop="PlaylistListView_Drop"
                          SelectionChanged="PlaylistListView_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,3" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button x:Name="DeletePlaylistButton"
                        Grid.Row="2"
                        Height="28" Margin="0,4,0,0"
                        IsEnabled="False"
                        ToolTip="Delete Playlist"
                        Click="DeletePlaylistButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="16" />
                </Button>
            </Grid>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <!-- Playlist track list -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock x:Name="PlaylistNameText"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="" />
                    <TextBlock x:Name="PlaylistTrackCountText"
                               HorizontalAlignment="Right"
                               FontSize="11" Foreground="Gray" />
                </Grid>

                <ListView x:Name="PlaylistTrackListView"
                          Grid.Row="1"
                          VirtualizingPanel.IsVirtualizing="True"
                          AllowDrop="True"
                          MouseDoubleClick="PlaylistTrackListView_MouseDoubleClick"
                          DragEnter="PlaylistTrackListView_DragEnter"
                          DragLeave="PlaylistTrackListView_DragLeave"
                          DragOver="PlaylistTrackListView_DragOver"
                          Drop="PlaylistTrackListView_Drop"
                          PreviewMouseLeftButtonDown="PlaylistTrackListView_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="PlaylistTrackListView_PreviewMouseMove">
                    <ListView.ContextMenu>
                        <ContextMenu Opened="PlaylistTrackContextMenu_Opened" />
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Title" Width="220"
                                            DisplayMemberBinding="{Binding Title}" />
                            <GridViewColumn Header="Time" Width="60"
                                            DisplayMemberBinding="{Binding Duration, StringFormat=mm\\:ss}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="ScanProgressBar"
                         Grid.Row="0"
                         Height="3"
                         Margin="0,0,0,4"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Foreground="Gray"
                       FontSize="12" />
        </Grid>

        <!-- Playback bar -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,6"
                Background="#F5F5F5" CornerRadius="4"
                x:Name="PlaybackBar">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image x:Name="PlaybackArtImage" Grid.Column="0"
                       Width="80" Height="80" Margin="0,0,12,0"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="default_art.png" />

                <Button x:Name="PlayPauseButton" Grid.Column="1"
                        Width="32" Height="28" Margin="0,0,4,0"
                        IsEnabled="False"
                        ToolTip="Play / Pause" Click="PlayPauseButton_Click">
                    <TextBlock x:Name="PlayPauseIcon"
                               FontFamily="Segoe MDL2 Assets" Text="&#xE769;" FontSize="14" />
                </Button>
                <Button x:Name="StopButton" Grid.Column="2"
                        Width="32" Height="28" Margin="0,0,10,0"
                        IsEnabled="False"
                        ToolTip="Stop" Click="StopButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" FontSize="14" />
                </Button>

                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="NowPlayingText" Grid.Row="0"
                               FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <Slider x:Name="SeekBar" Grid.Row="1"
                            IsEnabled="False"
                            Margin="0,2,0,0" VerticalAlignment="Center"
                            PreviewMouseDown="SeekBar_PreviewMouseDown"
                            PreviewMouseUp="SeekBar_PreviewMouseUp" />
                </Grid>

                <StackPanel Grid.Column="4" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="TimeText"
                               VerticalAlignment="Center"
                               FontSize="11" Foreground="Gray" />
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE767;"
                               FontSize="13" Margin="12,0,4,0" VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider"
                            Width="80" VerticalAlignment="Center"
                            Minimum="0" Maximum="1" Value="1"
                            ValueChanged="VolumeSlider_ValueChanged" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
