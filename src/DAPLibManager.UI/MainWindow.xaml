<Window x:Class="DAPLibManager.UI.MainWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:converters="clr-namespace:DAPLibManager.UI.Converters"
     Title="재생목록 관리자"
     Icon="app.ico"
     Background="#F0F9FF"
     Height="800" Width="1500"
     MinHeight="500" MinWidth="900">

    <Window.Resources>
        <converters:RelativePathConverter x:Key="RelativePath" />
        <converters:AlbumArtConverter x:Key="AlbumArt" />

        <!-- Soft secondary button: light lavender bg, violet icon -->
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BAE6FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BAE6FD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F9FF"/>
                                <Setter Property="Foreground" Value="#BAE6FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scrollbar thumb -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" CornerRadius="4" Background="#BAE6FD" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scrollbar page/line repeat buttons: invisible -->
        <Style x:Key="ScrollPageBtn" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical ScrollBar template -->
        <ControlTemplate x:Key="VerticalScrollBarTpl" TargetType="ScrollBar">
            <Grid>
                <Border CornerRadius="5" Background="#E0F2FE"/>
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageBtn}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageBtn}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <!-- Horizontal ScrollBar template -->
        <ControlTemplate x:Key="HorizontalScrollBarTpl" TargetType="ScrollBar">
            <Grid>
                <Border CornerRadius="5" Background="#E0F2FE"/>
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageBtn}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollPageBtn}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <!-- Implicit ScrollBar style -->
        <Style TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Template" Value="{StaticResource VerticalScrollBarTpl}"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTpl}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Implicit Button style: rounded violet -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#075985"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#BAE6FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button: red for delete actions -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FEF2F2"/>
                                <Setter Property="Foreground" Value="#FCA5A5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Playback control button: transparent on dark background -->
        <Style x:Key="PlaybackControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF25"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFFFFF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Implicit ToggleButton style -->
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BAE6FD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F9FF"/>
                                <Setter Property="Foreground" Value="#BAE6FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Implicit TextBox style: rounded with accent focus -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#082F49"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="#0284C7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GridViewColumnHeader: accent color, no resize -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#F0F9FF"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MediaElement x:Name="MediaPlayer"
                      Visibility="Collapsed"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      MediaOpened="MediaPlayer_MediaOpened"
                      MediaEnded="MediaPlayer_MediaEnded" />

        <!-- 3-panel content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="200" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="180" MinWidth="120" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Left: Toolbar / Search / [TreeView | TrackListView] -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="#0284C7"/>
                </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SelectFolderButton"
                            Style="{StaticResource SoftButton}"
                            Grid.Column="0"
                            Width="42" Height="36"
                            ToolTip="Select Folder"
                            Click="SelectFolderButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;" FontSize="18" />
                    </Button>

                    <TextBlock x:Name="FolderPathText"
                               Grid.Column="1"
                               Text="No folder selected"
                               VerticalAlignment="Center"
                               Margin="10,0"
                               FontSize="13"
                               Foreground="#9CA3AF"
                               TextTrimming="CharacterEllipsis" />

                    <Button x:Name="ScanButton"
                            Style="{StaticResource SoftButton}"
                            Grid.Column="2"
                            Width="42" Height="36"
                            IsEnabled="False"
                            ToolTip="Scan Library"
                            Click="ScanButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="18" />
                    </Button>
                </Grid>

                <!-- Search bar + 즐겨찾기 필터 -->
                <Grid Grid.Row="2" Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             FontSize="13"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged" />
                    <ToggleButton x:Name="FavoriteFilterBtn"
                                  Grid.Column="2"
                                  Width="36" Height="36"
                                  ToolTip="즐겨찾기만 보기"
                                  Checked="FavoriteFilterBtn_Changed"
                                  Unchecked="FavoriteFilterBtn_Changed">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   x:Name="FavoriteFilterIcon" Text="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!-- TreeView (left) + TrackListView (right) -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" MinWidth="80" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="2*" MinWidth="100" />
                    </Grid.ColumnDefinitions>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- Directory TreeView -->
                <TreeView x:Name="DirTreeView"
                          Grid.Column="0"
                          FontSize="13"
                          SelectedItemChanged="DirTreeView_SelectedItemChanged">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Padding" Value="2,3" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- horizontal dotted line -->
                                                <Rectangle Grid.Column="0" Height="1"
                                                           VerticalAlignment="Center"
                                                           Stroke="#BAE6FD" StrokeThickness="1"
                                                           StrokeDashArray="2,2" Fill="Transparent" />
                                                <DockPanel Grid.Column="1">
                                                    <ToggleButton x:Name="Expander" DockPanel.Dock="Left"
                                                                  Focusable="False" Width="16" Height="16"
                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="Transparent">
                                                                                <Path x:Name="Arrow" Fill="#0284C7"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Data="M 3 1 L 3 9 L 7 5 Z" />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="Arrow" Property="Data" Value="M 1 3 L 9 3 L 5 7 Z" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}">
                                                        <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                                          VerticalAlignment="Center" />
                                                    </Border>
                                                </DockPanel>
                                            </Grid>
                                            <!-- vertical dotted line + children -->
                                            <Grid x:Name="ItemsGrid">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Width="1"
                                                           HorizontalAlignment="Center"
                                                           Stroke="#BAE6FD" StrokeThickness="1"
                                                           StrokeDashArray="2,2" Fill="Transparent" />
                                                <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" />
                                            </Grid>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="False">
                                                <Setter TargetName="ItemsGrid" Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="#E0F2FE" />
                                                <Setter Property="Foreground"
                                                        Value="#0C4A6E" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.Resources>
                </TreeView>

                <!-- Library TrackListView -->
                <ListView x:Name="TrackListView"
                          Grid.Column="2"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="TrackListView_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="TrackListView_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="TrackListView_PreviewMouseMove">
                    <ListView.ContextMenu>
                        <ContextMenu Opened="TrackContextMenu_Opened" />
                    </ListView.ContextMenu>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="50" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="2,1" Margin="2,1">
                                            <GridViewRowPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F0F9FF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E0F2FE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="32">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="StarButton_Click"
                                                Width="26" Height="26"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE734;" />
                                                        <Setter Property="Foreground" Value="#AAAAAA" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Text" Value="&#xE735;" />
                                                                <Setter Property="Foreground" Value="#FFD700" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="#FFAA00" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="54">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Width="42" Height="42"
                                               Source="{Binding FilePath, Converter={StaticResource AlbumArt}}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Title" Width="200"
                                            DisplayMemberBinding="{Binding Title}">
                            </GridViewColumn>
                            <GridViewColumn Header="Artist" Width="150"
                                            DisplayMemberBinding="{Binding ArtistName}">
                            </GridViewColumn>
                            <GridViewColumn Header="Album" Width="150"
                                            DisplayMemberBinding="{Binding AlbumTitle}">
                            </GridViewColumn>
                            <GridViewColumn Header="Time" Width="65"
                                            DisplayMemberBinding="{Binding Duration, StringFormat=mm\\:ss}">
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                </Grid><!-- end TreeView+TrackList grid -->
            </Grid>
            </Border>

            <!-- Playlist panel -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="#0284C7"/>
                </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="6,0,6,6">
                    <TextBlock Text="Playlists" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="#0C4A6E" />
                    <Button x:Name="NewPlaylistButton"
                            Style="{StaticResource SoftButton}"
                            Width="28" Height="28"
                            HorizontalAlignment="Right"
                            IsEnabled="False"
                            ToolTip="New Playlist"
                            Click="NewPlaylistButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="15" />
                    </Button>
                </Grid>

                <ListView x:Name="PlaylistListView"
                          Grid.Row="1"
                          AllowDrop="True"
                          DragOver="PlaylistListView_DragOver"
                          Drop="PlaylistListView_Drop"
                          SelectionChanged="PlaylistListView_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="6,5" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F0F9FF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E0F2FE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button x:Name="DeletePlaylistButton"
                        Style="{StaticResource DangerButton}"
                        Grid.Row="2"
                        Height="34" Margin="0,6,0,0"
                        IsEnabled="False"
                        ToolTip="Delete Playlist"
                        Click="DeletePlaylistButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="18" />
                </Button>
            </Grid>
            </Border>

            <!-- Playlist track list -->
            <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Color="#0284C7"/>
                </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="6,0,0,6">
                    <TextBlock x:Name="PlaylistNameText"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#0C4A6E"
                               TextTrimming="CharacterEllipsis"
                               Text="" />
                    <TextBlock x:Name="PlaylistTrackCountText"
                               HorizontalAlignment="Right"
                               FontSize="12" Foreground="#9CA3AF" />
                </Grid>

                <ListView x:Name="PlaylistTrackListView"
                          Grid.Row="1"
                          VirtualizingPanel.IsVirtualizing="True"
                          AllowDrop="True"
                          MouseDoubleClick="PlaylistTrackListView_MouseDoubleClick"
                          DragEnter="PlaylistTrackListView_DragEnter"
                          DragLeave="PlaylistTrackListView_DragLeave"
                          DragOver="PlaylistTrackListView_DragOver"
                          Drop="PlaylistTrackListView_Drop"
                          PreviewMouseLeftButtonDown="PlaylistTrackListView_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="PlaylistTrackListView_PreviewMouseMove">
                    <ListView.ContextMenu>
                        <ContextMenu Opened="PlaylistTrackContextMenu_Opened" />
                    </ListView.ContextMenu>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="2,1" Margin="2,1">
                                            <GridViewRowPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F0F9FF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E0F2FE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Title" Width="240"
                                            DisplayMemberBinding="{Binding Title}">
                            </GridViewColumn>
                            <GridViewColumn Header="Time" Width="65"
                                            DisplayMemberBinding="{Binding Duration, StringFormat=mm\\:ss}">
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar x:Name="ScanProgressBar"
                         Grid.Row="0"
                         Height="4"
                         Margin="0,0,0,4"
                         Foreground="#0284C7"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Foreground="#0284C7"
                       FontSize="13" />
        </Grid>

        <!-- Playback bar -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="16,12"
                CornerRadius="12"
                x:Name="PlaybackBar">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0C4A6E" Offset="0"/>
                    <GradientStop Color="#0284C7" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Favorite toggle -->
                <ToggleButton x:Name="PlaybackFavoriteBtn" Grid.Column="0"
                              Width="36" Height="36" Margin="0,0,8,0"
                              IsEnabled="False" VerticalAlignment="Center"
                              ToolTip="즐겨찾기" Cursor="Hand"
                              Click="PlaybackFavoriteBtn_Click">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ControlTemplate>
                    </ToggleButton.Template>
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="28">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE734;" />
                                <Setter Property="Foreground" Value="#BAE6FD" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                        <Setter Property="Text" Value="&#xE735;" />
                                        <Setter Property="Foreground" Value="#FFD700" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FFAA00" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ToggleButton>

                <!-- Album art -->
                <Image x:Name="PlaybackArtImage" Grid.Column="1"
                       Width="90" Height="90" Margin="0,0,14,0"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="default_art.png" />

                <!-- Center: title / seek bar / control buttons -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="NowPlayingText" Grid.Row="0"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis" />

                    <Slider x:Name="SeekBar" Grid.Row="1"
                            IsEnabled="False"
                            IsMoveToPointEnabled="True"
                            Margin="0,6,0,0" VerticalAlignment="Center"
                            PreviewMouseDown="SeekBar_PreviewMouseDown"
                            PreviewMouseUp="SeekBar_PreviewMouseUp" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0"
                                HorizontalAlignment="Center">
                        <Button x:Name="PlayPauseButton"
                                Style="{StaticResource PlaybackControlBtn}"
                                Width="38" Height="34" Margin="0,0,6,0"
                                IsEnabled="False"
                                ToolTip="재생 / 일시정지" Click="PlayPauseButton_Click">
                            <TextBlock x:Name="PlayPauseIcon"
                                       FontFamily="Segoe MDL2 Assets" Text="&#xE769;" FontSize="16" />
                        </Button>
                        <Button x:Name="StopButton"
                                Style="{StaticResource PlaybackControlBtn}"
                                Width="38" Height="34"
                                IsEnabled="False"
                                ToolTip="정지" Click="StopButton_Click">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Time + Volume -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="TimeText"
                               VerticalAlignment="Center"
                               FontSize="12" Foreground="#BAE6FD"
                               Width="110" />
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE767;"
                               FontSize="15" Margin="14,0,6,0" VerticalAlignment="Center"
                               Foreground="White" />
                    <Slider x:Name="VolumeSlider"
                            Width="100" VerticalAlignment="Center"
                            Minimum="0" Maximum="1" Value="1"
                            IsMoveToPointEnabled="True"
                            ValueChanged="VolumeSlider_ValueChanged" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
